# ---------------------------------------------------------------------------
# RepoLens configuration. Copy to `.env` (backend) / `frontend/.env.local`.
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Backend (FastAPI) ------------------------------------------------------

# Optional. A GitHub token raises the API limit from 60 to 5,000 requests/hour.
# A fine-grained token with *no* extra permissions (public read-only) is enough.
GITHUB_TOKEN=

# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000

# Analysis limits (defaults shown).
MAX_TREE_ENTRIES=50000
MAX_FILES_TO_FETCH=300
MAX_FILE_BYTES=400000
MAX_TOTAL_FETCH_BYTES=20000000

# Abuse protection (per client IP; 0 disables a limit).
RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_HOUR=20
MAX_CONCURRENT_ANALYSES=4
ANALYSIS_TIMEOUT_SECONDS=110
# Honor X-Forwarded-For. Enable ONLY when the backend is reachable exclusively through a
# trusted proxy (e.g. the RepoLens frontend or a load balancer); otherwise clients can spoof it.
TRUST_PROXY_HEADERS=false
# Serve interactive API docs at /docs.
ENABLE_DOCS=true

# Optional AI summary. Leave AI_PROVIDER empty to disable it entirely: every other feature
# works without AI. The model only receives RepoLens's analysis, never raw repository files.
#   anthropic - Claude via the official SDK (install with: pip install -e ".[ai]")
#               AI_MODEL defaults to claude-opus-5
#   openai    - any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, local Ollama, ...)
#               AI_MODEL is required; set AI_BASE_URL for non-OpenAI endpoints,
#               e.g. http://localhost:11434/v1 for Ollama (AI_API_KEY may stay empty)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# In-process caches (seconds / entries; 0 disables)
CACHE_TTL_SECONDS=600
AI_CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=64

LOG_LEVEL=INFO

# --- Frontend (Next.js) -----------------------------------------------------

# Base URL of the backend API as seen by the Next.js server.
REPOLENS_API_URL=http://localhost:8000
